---
import Layout from "../../layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";

const accessToken = Astro.url.searchParams.get("access_token");
const recoveryType = Astro.url.searchParams.get("type");
const emailHint = Astro.url.searchParams.get("email");
const resolvedToken = recoveryType === "recovery" ? accessToken : null;
---

<Layout title="Nowe hasło | 10x Cards">
  <main class="min-h-screen bg-gradient-to-b from-background via-background to-muted/20 text-foreground">
    <section class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.55fr)_minmax(0,0.45fr)] lg:items-center">
        <header class="space-y-6 rounded-2xl border border-dashed border-border/60 bg-muted/10 p-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary/80">Ostatni krok</p>
          <h1 class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl">Ustaw nowe hasło</h1>
          <p class="text-base text-muted-foreground md:text-lg">
            Skorzystaj z linku z wiadomości email, aby ustawić nowe hasło. Dla bezpieczeństwa link jest jednorazowy i
            wygasa po krótkim czasie.
          </p>
          <ul class="grid gap-3 text-sm text-muted-foreground">
            <li class="flex items-center gap-3">
              <span class="grid size-6 place-items-center rounded-full bg-primary/10 text-primary">✓</span>
              Po zapisaniu nowego hasła zalogujesz się nim w aplikacji.
            </li>
            <li class="flex items-center gap-3">
              <span class="grid size-6 place-items-center rounded-full bg-primary/10 text-primary">✓</span>
              Jeżeli link wygasł, możesz wygenerować nowy na stronie resetu hasła.
            </li>
          </ul>
        </header>

        <div class="flex justify-center lg:justify-end">
          <ResetPasswordForm client:idle accessToken={resolvedToken} emailHint={emailHint} />
        </div>
      </div>
    </section>
  </main>
</Layout>
