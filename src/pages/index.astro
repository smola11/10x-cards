---
import Layout from "../layouts/Layout.astro";
import GenerationPanel from "@/components/generation/GenerationPanel";
---

<Layout>
  <main class="min-h-screen bg-background text-foreground">
    <section class="mx-auto flex max-w-6xl flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
      <header class="mb-10 space-y-4 text-center sm:text-left">
        <p class="text-sm font-medium uppercase tracking-wider text-muted-foreground">AI Flashcards</p>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Generowanie fiszek z pomocą AI</h1>
        <p class="text-muted-foreground text-base sm:text-lg">
          Wklej długi tekst, wygeneruj propozycje fiszek, edytuj je i zaakceptuj wszystkie lub tylko wybrane.
        </p>
      </header>
      <GenerationPanel client:visible />
    </section>
  </main>
</Layout>
